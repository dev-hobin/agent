{
  "name": "@hobin/observer",
  "version": "0.1.6",
  "private": true,
  "description": "A local-first Pi inquiry sidecar with reviewed, source-linked Markdown notebook publication.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "observer",
    "zettelkasten",
    "inquiry"
  ],
  "license": "MIT",
  "author": {
    "name": "dev-hobin",
    "url": "https://github.com/dev-hobin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-hobin/agent.git",
    "directory": "packages/observer"
  },
  "homepage": "https://github.com/dev-hobin/agent/tree/main/packages/observer#readme",
  "bugs": {
    "url": "https://github.com/dev-hobin/agent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "src",
    "schemas",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node scripts/check-package.mjs && node --test tests/*.test.ts",
    "eval": "node scripts/eval-rpc.mjs",
    "release:check": "pnpm run check && node scripts/check-release.mjs",
    "prepublishOnly": "pnpm run release:check"
  },
  "pi": {
    "extensions": ["./extensions/observer.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.10 <0.84.0",
    "@earendil-works/pi-tui": ">=0.80.10 <0.84.0",
    "typebox": "^1.3.6"
  },
  "dependencies": {
    "@hobin/judgment": "workspace:^0.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "xstate": "5.32.5",
    "yaml": "^2.9.0"
  }
}
