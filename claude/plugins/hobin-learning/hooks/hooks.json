{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/output-contract-hook.mjs\" claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/output-contract-hook.mjs\" claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/output-contract-hook.mjs\" claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/output-contract-hook.mjs\" claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/output-contract-hook.mjs\" claude"
          }
        ]
      }
    ]
  }
}
