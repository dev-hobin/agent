{
  "kind": "plugin-eval-benchmark",
  "schemaVersion": 2,
  "version": 2,
  "targetKind": "plugin",
  "targetName": "hobin-learning",
  "runner": {
    "type": "codex-cli",
    "model": "gpt-5.4",
    "sandbox": "workspace-write",
    "approvalPolicy": "never",
    "extraArgs": []
  },
  "workspace": {
    "sourcePath": "codex/evals/hobin-learning/patternize-retry-notes/workspace",
    "setupMode": "copy",
    "preserve": "on-failure"
  },
  "targetProvisioning": {
    "mode": "workspace-plugin-marketplace"
  },
  "verifiers": {
    "commands": [
      "node \"$HOBIN_AGENT_ROOT/.agents/skills/implementing-core/scripts/scenario-check.mjs\" \"$HOBIN_AGENT_ROOT/core/patternize/scenarios/retry-notes/scenario.yaml\" \"$HOBIN_AGENT_ROOT/codex/evals/hobin-learning/patternize-retry-notes/workspace\" .\" --ignore plugins/ --ignore .agents/plugins/"
    ]
  },
  "notes": [
    "Run sh codex/evals/prepare.sh hobin-learning patternize-retry-notes first, from the repository root, with HOBIN_AGENT_ROOT set to it; pass --model to choose the model (plugin-eval ignores -m)."
  ],
  "scenarios": [
    {
      "id": "retry-notes",
      "title": "patternize-retry-notes",
      "purpose": "Acceptance scenario from core/patternize/SPEC.md §8",
      "userInput": "$hobin-learning:patternize Use the patternize skill for this.\n\nThe three notes in notes/ come from different incidents. Turn what they have in common into a reusable pattern I can follow the next time a call with side effects might be retried, and check it against cases it should and shouldn't cover. Save the result to out/pattern.md.",
      "successChecklist": [
        "artifact-written",
        "has-case-table",
        "has-context",
        "has-axis",
        "has-forces",
        "has-roles",
        "has-ordered-moves",
        "has-checks",
        "cites-order-note",
        "cites-label-note",
        "cites-payout-note",
        "has-transfer-case",
        "has-boundary",
        "has-falsifier",
        "notes-unchanged",
        "meets-output-contract"
      ]
    }
  ]
}
