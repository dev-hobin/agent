{
  "kind": "plugin-eval-benchmark",
  "schemaVersion": 2,
  "version": 2,
  "targetKind": "plugin",
  "targetName": "hobin-stances",
  "runner": {
    "type": "codex-cli",
    "model": "gpt-5.4",
    "sandbox": "workspace-write",
    "approvalPolicy": "never",
    "extraArgs": []
  },
  "workspace": {
    "sourcePath": "codex/evals/hobin-stances/agents-md-overlap/workspace",
    "setupMode": "copy",
    "preserve": "on-failure"
  },
  "targetProvisioning": {
    "mode": "workspace-plugin-marketplace"
  },
  "verifiers": {
    "commands": [
      "node \"$HOBIN_AGENT_ROOT/.agents/skills/implementing-core/scripts/scenario-check.mjs\" \"$HOBIN_AGENT_ROOT/core/applying-stances/scenarios/agents-md-overlap/scenario.yaml\" \"$HOBIN_AGENT_ROOT/codex/evals/hobin-stances/agents-md-overlap/workspace\" . --ignore plugins/ --ignore .agents/plugins/"
    ]
  },
  "notes": [
    "Run sh codex/evals/prepare.sh hobin-stances agents-md-overlap first, from the repository root, with HOBIN_AGENT_ROOT set to it; pass --model to choose the model (plugin-eval ignores -m)."
  ],
  "scenarios": [
    {
      "id": "agents-md-overlap",
      "title": "agents-md-overlap",
      "purpose": "Acceptance scenario from core/applying-stances/SPEC.md §8",
      "userInput": "$hobin-stances:applying-stances Apply the hobin engineering stances to this project's agent instructions. Write the proposal you would show me to `PROPOSAL.md` in the repository root, and do not change any other file.",
      "successChecklist": [
        "proposal-written",
        "targets-agents-md",
        "shows-diff",
        "asks-approval",
        "no-duplicate-verification-stance",
        "no-other-changes",
        "block-valid"
      ]
    }
  ]
}
