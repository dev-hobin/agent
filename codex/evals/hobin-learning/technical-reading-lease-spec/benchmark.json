{
  "kind": "plugin-eval-benchmark",
  "targetKind": "plugin",
  "targetName": "hobin-learning",
  "runner": {
    "type": "codex-cli",
    "model": "gpt-5.4",
    "sandbox": "workspace-write",
    "approvalPolicy": "never",
    "extraArgs": []
  },
  "workspace": {
    "sourcePath": "codex/evals/hobin-learning/technical-reading-lease-spec/workspace",
    "setupMode": "copy",
    "preserve": "on-failure"
  },
  "targetProvisioning": {
    "mode": "workspace-plugin-marketplace"
  },
  "verifiers": {
    "commands": [
      "node \"$HOBIN_AGENT_ROOT/.agents/skills/implementing-core/scripts/scenario-check.mjs\" \"$HOBIN_AGENT_ROOT/core/technical-reading/scenarios/lease-spec/scenario.yaml\" \"$HOBIN_AGENT_ROOT/codex/evals/hobin-learning/technical-reading-lease-spec/workspace\" .\""
    ]
  },
  "notes": [
    "Run sh codex/evals/prepare.sh hobin-learning technical-reading-lease-spec first, from the repository root, with HOBIN_AGENT_ROOT set to it; pass -m to choose the model."
  ],
  "scenarios": [
    {
      "id": "lease-spec",
      "title": "technical-reading-lease-spec",
      "purpose": "Acceptance scenario from core/technical-reading/SPEC.md §8",
      "userInput": "$hobin-learning:technical-reading I just read docs/lease-spec.md for a design review next week. What should I actually carry forward from it, beyond a summary? Keep what the spec says separate from your interpretation. Save the result to out/insights.md.",
      "successChecklist": [
        "artifact-written",
        "has-source-scope",
        "names-the-source",
        "has-insight",
        "has-source-evidence",
        "cites-storage-rule",
        "keeps-source-term",
        "labels-source-claims",
        "labels-inferences",
        "has-example-or-contrast",
        "has-boundary-or-misreading",
        "has-practical-consequence",
        "has-unresolved-question",
        "source-unchanged",
        "meets-output-contract"
      ]
    }
  ]
}
