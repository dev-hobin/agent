{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "node \"$PLUGIN_ROOT/scripts/scenarios-stop-hook.mjs\" codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"$PLUGIN_ROOT/scripts/scenarios-stop-hook.mjs\" codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 300,
            "command": "node \"$PLUGIN_ROOT/scripts/scenarios-stop-hook.mjs\" codex"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "node \"$PLUGIN_ROOT/scripts/scenarios-stop-hook.mjs\" codex"
          }
        ]
      }
    ]
  }
}
