{
  "kind": "plugin-eval-benchmark",
  "schemaVersion": 2,
  "version": 2,
  "targetKind": "plugin",
  "targetName": "hobin-learning",
  "runner": {
    "type": "codex-cli",
    "model": "gpt-5.4",
    "sandbox": "workspace-write",
    "approvalPolicy": "never",
    "extraArgs": []
  },
  "workspace": {
    "sourcePath": "codex/evals/hobin-learning/exercise-fencing-note/workspace",
    "setupMode": "copy",
    "preserve": "on-failure"
  },
  "targetProvisioning": {
    "mode": "workspace-plugin-marketplace"
  },
  "verifiers": {
    "commands": [
      "node \"$HOBIN_AGENT_ROOT/.agents/skills/implementing-core/scripts/scenario-check.mjs\" \"$HOBIN_AGENT_ROOT/core/exercise/scenarios/fencing-note/scenario.yaml\" \"$HOBIN_AGENT_ROOT/codex/evals/hobin-learning/exercise-fencing-note/workspace\" .\" --ignore plugins/ --ignore .agents/plugins/"
    ]
  },
  "notes": [
    "Run sh codex/evals/prepare.sh hobin-learning exercise-fencing-note first, from the repository root, with HOBIN_AGENT_ROOT set to it; pass --model to choose the model (plugin-eval ignores -m)."
  ],
  "scenarios": [
    {
      "id": "fencing-note",
      "title": "exercise-fencing-note",
      "purpose": "Acceptance scenario from core/exercise/SPEC.md §8",
      "userInput": "$hobin-learning:exercise I wrote up notes/fencing-tokens.md after reading about leases. Make me a short practice workbook so I can show I can actually use the idea, not just repeat the words. Save it to out/exercise.md.",
      "successChecklist": [
        "artifact-written",
        "names-target",
        "has-prediction-task",
        "has-worked-example",
        "has-misconception-trap",
        "has-answer-key",
        "has-hint",
        "has-retry-rule",
        "has-transfer-task",
        "has-mastery-rubric",
        "notes-unchanged",
        "meets-output-contract"
      ]
    }
  ]
}
