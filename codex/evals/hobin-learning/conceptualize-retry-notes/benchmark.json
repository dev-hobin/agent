{
  "kind": "plugin-eval-benchmark",
  "targetKind": "plugin",
  "targetName": "hobin-learning",
  "runner": {
    "type": "codex-cli",
    "model": "gpt-5.4",
    "sandbox": "workspace-write",
    "approvalPolicy": "never",
    "extraArgs": []
  },
  "workspace": {
    "sourcePath": "codex/evals/hobin-learning/conceptualize-retry-notes/workspace",
    "setupMode": "copy",
    "preserve": "on-failure"
  },
  "targetProvisioning": {
    "mode": "workspace-plugin-marketplace"
  },
  "verifiers": {
    "commands": [
      "node \"$HOBIN_AGENT_ROOT/.agents/skills/implementing-core/scripts/scenario-check.mjs\" \"$HOBIN_AGENT_ROOT/core/conceptualize/scenarios/retry-notes/scenario.yaml\" \"$HOBIN_AGENT_ROOT/codex/evals/hobin-learning/conceptualize-retry-notes/workspace\" .\""
    ]
  },
  "notes": [
    "Run sh codex/evals/prepare.sh hobin-learning conceptualize-retry-notes first, from the repository root, with HOBIN_AGENT_ROOT set to it; pass -m to choose the model."
  ],
  "scenarios": [
    {
      "id": "retry-notes",
      "title": "conceptualize-retry-notes",
      "purpose": "Acceptance scenario from core/conceptualize/SPEC.md §8",
      "userInput": "$hobin-learning:conceptualize Use the conceptualize skill for this.\n\nThe three notes in notes/ come from different incidents. Form one concept that holds across all of them, something I can reuse outside these systems, and test whether it really transfers. Save the result to out/concept.md.",
      "successChecklist": [
        "artifact-written",
        "has-definition",
        "has-mechanism",
        "has-evidence-section",
        "cites-order-note",
        "cites-label-note",
        "cites-payout-note",
        "has-transfer-case",
        "has-boundary",
        "has-relations",
        "notes-unchanged"
      ]
    }
  ]
}
