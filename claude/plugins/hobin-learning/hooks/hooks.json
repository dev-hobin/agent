{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/output-contract-hook.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/output-contract-hook.mjs\""
          }
        ]
      }
    ]
  }
}
