{
  "kind": "plugin-eval-benchmark",
  "schemaVersion": 2,
  "version": 2,
  "targetKind": "plugin",
  "targetName": "hobin-learning",
  "runner": {
    "type": "codex-cli",
    "model": "gpt-5.4",
    "sandbox": "workspace-write",
    "approvalPolicy": "never",
    "extraArgs": []
  },
  "workspace": {
    "sourcePath": "codex/evals/hobin-learning/opensource-reading-token-bucket/workspace",
    "setupMode": "copy",
    "preserve": "on-failure"
  },
  "targetProvisioning": {
    "mode": "workspace-plugin-marketplace"
  },
  "verifiers": {
    "commands": [
      "node \"$HOBIN_AGENT_ROOT/.agents/skills/implementing-core/scripts/scenario-check.mjs\" \"$HOBIN_AGENT_ROOT/core/opensource-reading/scenarios/token-bucket/scenario.yaml\" \"$HOBIN_AGENT_ROOT/codex/evals/hobin-learning/opensource-reading-token-bucket/workspace\" .\" --ignore plugins/ --ignore .agents/plugins/"
    ]
  },
  "notes": [
    "Run sh codex/evals/prepare.sh hobin-learning opensource-reading-token-bucket first, from the repository root, with HOBIN_AGENT_ROOT set to it; pass --model to choose the model (plugin-eval ignores -m)."
  ],
  "scenarios": [
    {
      "id": "token-bucket",
      "title": "opensource-reading-token-bucket",
      "purpose": "Acceptance scenario from core/opensource-reading/SPEC.md §8",
      "userInput": "$hobin-learning:opensource-reading I want to learn how this repository's `take()` keeps the promise its README makes. Trace it through the code and tests, and tell me what evidence would prove your reading wrong. Save the study to out/study.md.",
      "successChecklist": [
        "artifact-written",
        "has-slice",
        "has-promise",
        "cites-readme",
        "cites-implementation",
        "cites-tests",
        "labels-direct-evidence",
        "labels-inference-or-gap",
        "has-invariant-or-tradeoff",
        "has-falsifier",
        "has-next-move",
        "repository-unchanged",
        "meets-output-contract"
      ]
    }
  ]
}
