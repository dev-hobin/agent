{
  "name": "@hobin/judgment",
  "version": "0.1.0",
  "description": "A side-effect-free engine for policy-aware context selection, sealing, coverage, and outcomes.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "judgment",
    "context",
    "policy"
  ],
  "license": "MIT",
  "author": {
    "name": "dev-hobin",
    "url": "https://github.com/dev-hobin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-hobin/agent.git",
    "directory": "packages/judgment"
  },
  "homepage": "https://github.com/dev-hobin/agent/tree/main/packages/judgment#readme",
  "bugs": {
    "url": "https://github.com/dev-hobin/agent/issues"
  },
  "files": [
    "schemas",
    "docs",
    "src",
    "dist",
    "bin",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "bin": {
    "judgment": "./bin/judgment.mjs"
  },
  "types": "./src/index.ts",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node scripts/build-cli.mjs --check && node scripts/build-public-api.mjs --check && node scripts/check-package.mjs && node --test tests/*.test.ts",
    "schema:write": "node scripts/write-schema.mjs",
    "cli:build": "node scripts/build-cli.mjs",
    "api:build": "node scripts/build-public-api.mjs",
    "prepack": "node scripts/build-cli.mjs --check && node scripts/build-public-api.mjs --check"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./src/node/seal-context.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./pi-context": {
      "types": "./src/pi-context/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./schema": "./schemas/judgment-authoring.schema.json"
  },
  "pi": {},
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "dependencies": {}
}
