{
  "name": "@hobin/developer",
  "version": "0.1.19",
  "description": "A Pi root runtime for explicit coding judgments, bounded mutation, and claim-relative verification.",
  "type": "module",
  "keywords": ["pi-package", "pi", "developer", "skills"],
  "license": "MIT",
  "author": {
    "name": "dev-hobin",
    "url": "https://github.com/dev-hobin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-hobin/agent.git",
    "directory": "packages/developer"
  },
  "homepage": "https://github.com/dev-hobin/agent/tree/main/packages/developer#readme",
  "bugs": {
    "url": "https://github.com/dev-hobin/agent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "skills",
    "src",
    "docs",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node scripts/check-package.mjs && node --test tests/*.test.ts",
    "eval": "node scripts/eval-rpc.mjs",
    "eval:json": "node scripts/eval-json.mjs",
    "eval:live": "node scripts/eval-live.mjs --transport rpc",
    "eval:live:json": "node scripts/eval-live.mjs --transport json"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": ["./extensions/developer.ts"],
    "skills": ["./skills"]
  },
  "devDependencies": {
    "typebox": "1.1.38"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@hobin/judgment": "workspace:^0.1.0"
  }
}
