{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"$PLUGIN_ROOT/scripts/output-contract-hook.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"$PLUGIN_ROOT/scripts/output-contract-hook.mjs\""
          }
        ]
      }
    ]
  }
}
