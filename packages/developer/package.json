{
  "name": "@hobin/developer",
  "version": "0.1.20",
  "description": "A model-neutral Action Loop for evidence-backed engineering work in Pi.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "developer",
    "skills"
  ],
  "license": "MIT",
  "author": {
    "name": "dev-hobin",
    "url": "https://github.com/dev-hobin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-hobin/agent.git",
    "directory": "packages/developer"
  },
  "homepage": "https://github.com/dev-hobin/agent/tree/main/packages/developer#readme",
  "bugs": {
    "url": "https://github.com/dev-hobin/agent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "src/action-loop",
    "skills",
    "docs",
    "dist",
    "README.md",
    "REFERENCE_ROUTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json && node scripts/build-sdk-public-api.mjs --check && node scripts/check-package.mjs && node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "sdk:build": "node scripts/build-sdk-public-api.mjs",
    "eval:live:sdk:routing": "node scripts/eval-sdk-routing.ts",
    "eval:live:sdk:judgment": "node scripts/eval-sdk-judgment.ts",
    "eval:live:sdk:intervention": "node scripts/eval-sdk-intervention.ts",
    "eval:live:sdk:remediation": "node scripts/eval-sdk-remediation.ts",
    "eval:live:sdk:resume": "node scripts/eval-sdk-action-loop-resume.mjs",
    "prepack": "tsc -p tsconfig.json && node scripts/build-sdk-public-api.mjs --check"
  },
  "exports": {
    "./sdk": {
      "types": "./src/action-loop/sdk/index.ts",
      "import": "./dist/sdk.mjs",
      "default": "./dist/sdk.mjs"
    }
  },
  "pi": {
    "extensions": [
      "./extensions/developer.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.10",
    "@earendil-works/pi-coding-agent": ">=0.80.10",
    "@earendil-works/pi-tui": ">=0.80.10",
    "typebox": "*"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
