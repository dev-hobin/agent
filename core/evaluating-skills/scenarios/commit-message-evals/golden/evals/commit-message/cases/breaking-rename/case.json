{
  "id": "breaking-rename",
  "setup": "setup.sh",
  "request": "Can you give me a commit message for the staged rename? Put only the message in COMMIT_MSG.txt.",
  "checks": [
    { "id": "message-written", "file_exists": "COMMIT_MSG.txt" },
    { "id": "refactor-with-billing-scope", "file_matches": { "path": "COMMIT_MSG.txt", "pattern": "^(```[a-z]*\\n)?refactor\\(billing\\)!?: [a-z]" } },
    { "id": "subject-at-most-50", "file_matches": { "path": "COMMIT_MSG.txt", "pattern": "^(```[a-z]*\\n)?[^\\n]{1,50}(\\n|$)" } },
    { "id": "breaking-footer-names-export", "file_matches": { "path": "COMMIT_MSG.txt", "pattern": "^BREAKING CHANGE: [^\\n]*formatPrice", "flags": "m" } }
  ],
  "reference": "reference"
}
